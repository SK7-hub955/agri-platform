# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Gmail SMTP credentials (use a Gmail App Password, not your account password)
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-address@gmail.com
GMAIL_PASS=your-16-char-app-password

# Server port
PORT=3001

# Node environment
NODE_ENV=development

# Frontend origin allowed by CORS
# Local development: http://localhost:5173
# Production: https://agri-platform.onrender.com
FRONTEND_URL=http://localhost:5173

# Market price provider: "silv" for live data, anything else uses built-in fallback
MARKET_PRICE_PROVIDER=silv
# Comma-separated Silv categories, or "all"
MARKET_PRICE_CATEGORIES=dairy,livestock
