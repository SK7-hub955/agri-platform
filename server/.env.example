# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Database (PostgreSQL) ----
# Full connection string. Render provides this automatically via fromDatabase.
# Local development example:
DATABASE_URL=postgres://agri:agri_dev_pw@127.0.0.1:5432/agriconnect
# Set to "true" for managed/hosted Postgres that requires SSL (e.g. Render).
DATABASE_SSL=false

# ---- Auth ----
# Secret used to sign JWTs. REQUIRED in production. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d
# bcrypt cost factor
BCRYPT_ROUNDS=10
# How long an email verification code stays valid (minutes)
VERIFICATION_CODE_TTL_MINUTES=1440

# ---- Email (optional) ----
# Gmail SMTP credentials (use a Gmail App Password, not your account password)
# https://myaccount.google.com/apppasswords
# If unset, verification codes are still generated but no email is sent.
GMAIL_USER=your-address@gmail.com
GMAIL_PASS=your-16-char-app-password

# ---- Server ----
PORT=3001
NODE_ENV=development
# Frontend origin allowed by CORS
# Local development: http://localhost:5173
# Production: https://agri-platform.onrender.com
FRONTEND_URL=http://localhost:5173

# ---- Market prices ----
# Market price provider: "silv" for live data
MARKET_PRICE_PROVIDER=silv
# Comma-separated Silv categories, or "all"
MARKET_PRICE_CATEGORIES=dairy,livestock
