# Gmail SMTP Configuration
# Use a Gmail App Password (not your regular password)
# https://support.google.com/accounts/answer/185833
# 1. Enable 2-Step Verification in Google Account
# 2. Go to App Passwords (https://myaccount.google.com/apppasswords)
# 3. Select Mail and Windows Computer
# 4. Copy the 16-character password (without spaces)

GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# Server port
PORT=3001

# Node environment
NODE_ENV=production

# Frontend URL (for CORS)
# Local development: http://localhost:5173
# Render deployment: https://agri-platform.onrender.com
FRONTEND_URL=http://localhost:5173

# Market price provider
# Use the Silv Data API to fetch live commodity prices with no auth required.
MARKET_PRICE_PROVIDER=silv
MARKET_PRICE_CATEGORIES=dairy,livestock

# ============================================
# RENDER DEPLOYMENT SETUP
# ============================================
# 1. Create Web Service on Render.com
# 2. Connect GitHub repository
# 3. Set Root Directory: server/
# 4. Build Command: npm install
# 5. Start Command: npm start
# 6. Add Environment Variables in Render Dashboard:
#    - GMAIL_USER
#    - GMAIL_PASS
#    - FRONTEND_URL (update to your frontend URL)
# 7. Deploy!

